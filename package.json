{
  "name": "ppp-ecommerce",
  "version": "1.0.0",
  "description": "API REST e site Web de um e-commerce com Login, Cadastro, Carrinho e Finalização de Compra",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "cy:open": "cypress open --e2e --browser chrome",
    "cy:run": "cypress run --e2e --browser chrome",
    "test:web": "start-server-and-test start http://localhost:3030/api/health cy:run",
    "api:run": "mocha \"test/api/*.test.mjs\"",
    "api:run:bugs": "mocha \"test/api/bugs-conhecidos/*.test.mjs\" --reporter-option reportFilename=relatorio-bugs-conhecidos",
    "test:api": "start-server-and-test start http://localhost:3030/api/health api:run",
    "test:api:bugs": "start-server-and-test start http://localhost:3030/api/health api:run:bugs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb-memory-server": "^11.3.0",
    "mongoose": "^9.12.2",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "chai": "^6.3.0",
    "cypress": "^16.4.0",
    "cypress-mochawesome-reporter": "^5.0.0",
    "mocha": "^12.0.3",
    "mochawesome": "^8.1.1",
    "start-server-and-test": "^3.0.13",
    "supertest": "^7.3.2"
  }
}
